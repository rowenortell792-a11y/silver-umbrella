"use client";

import { useState } from "react";
import { parseScene } from "../engine/parser";
import { runEvents } from "../engine/eventBus";
import { PulseMeter } from "../components/PulseMeter";

export default function Home() {
  const [scene, setScene] = useState("");
  const [activeEvents, setActiveEvents] = useState<{symbol: string, action: string}[]>([]);
  const [cleanText, setCleanText] = useState("");

  const handleBuild = () => {
    const result = parseScene(scene, "IMMERSIVE");
    setCleanText(result.cleanedText);
    setActiveEvents(result.events);
    runEvents(result.events);
  };

  return (
    <div style={{ padding: "40px", backgroundColor: "#050505", color: "#e0e0e0", fontFamily: "monospace", minHeight: "100vh" }}>
      <header style={{ borderBottom: "2px solid #333", paddingBottom: "20px", marginBottom: "30px" }}>
        <h1 style={{ margin: 0, letterSpacing: "4px", color: "#fff" }}>GGC IMMERSIVE EDITOR</h1>
        <div style={{ backgroundColor: "#ffcc00", color: "#000", padding: "4px 12px", display: "inline-block", fontWeight: "bold", marginTop: "10px" }}>MODE: IMMERSIVE</div>
      </header>

      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "40px" }}>
        <div style={{ backgroundColor: "#111", padding: "20px", border: "1px solid #333" }}>
          <textarea
            style={{ width: "100%", height: "250px", backgroundColor: "#000", color: "#00ffcc", border: "1px solid #444", padding: "15px", fontSize: "16px", outline: "none" }}
            placeholder="Type your scene. Use ⚡, 🌑, ◈, ~~~, ⧫ to trigger the Pulse..."
            value={scene}
            onChange={(e) => setScene(e.target.value)}
          />
          <button 
            onClick={handleBuild}
            style={{ width: "100%", padding: "15px", backgroundColor: "#fff", border: "none", fontWeight: "bold", cursor: "pointer", marginTop: "10px" }}
          >
            COMPILE SCENE
          </button>
        </div>

        <div style={{ backgroundColor: "#111", padding: "20px", border: "1px solid #333" }}>
          <PulseMeter activeEvents={activeEvents} />
          
          <div style={{ backgroundColor: "#000", padding: "15px", marginTop: "20px", border: "1px solid #222" }}>
            <h3 style={{ color: "#888", fontSize: "12px", margin: "0 0 10px 0" }}>◈ CLEANED CANON</h3>
            <p style={{ color: "#aaa", fontSize: "16px" }}>{cleanText || "Awaiting compilation..."}</p>
          </div>
        </div>
      </div>
    </div>
  );
}
